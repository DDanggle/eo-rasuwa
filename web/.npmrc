# Vercel의 pnpm 10.x는 strict-dep-builds를 켜서 "ignored build scripts" 경고를
# 하드 에러로 승격한다. 허용목록(sharp, unrs-resolver)은 package.json(pnpm 10.0~10.8)과
# pnpm-workspace.yaml(10.9+/11) 양쪽에 있으므로 정상 경로에서는 이 설정이 무의미하지만,
# 어느 쪽도 읽지 못하는 버전 조합에서도 설치가 실패하지 않도록 에러 승격만 끈다.
# (이 프로젝트는 이미지 최적화를 쓰지 않아 sharp 네이티브 빌드가 없어도 동작한다.)
strict-dep-builds=false
