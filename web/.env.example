# Vercel Project Settings > Environment Variables 에 그대로 입력 (Production/Preview).
# NEXT_PUBLIC_* 은 브라우저 번들에 그대로 들어가므로 비밀값을 넣지 않는다.

# 최종 HTTPS 도메인. layout metadataBase / OG 이미지 절대경로에 쓰인다.
# 커스텀 도메인 연결 전에는 Vercel 기본 도메인을 넣고, 연결 후 교체한다.
NEXT_PUBLIC_SITE_URL=https://eo-rasuwa.dev

# 없으면 Esri 래스터 베이스맵으로 폴백. 새 키를 발급하고 배포 도메인 origin 제한 + 사용량 상한을 건다.
NEXT_PUBLIC_MAPTILER_KEY=

# 공개 릴리스에서는 false. 리뷰 노트 UI 를 켤 때만 true.
NEXT_PUBLIC_ENABLE_REVIEW_NOTES=false

# 1차 공개에서는 비워둔다. Supabase 리뷰는 인증 흐름을 붙인 뒤에만 설정한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
